# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Models (any OpenRouter model id; swap the string, nothing else)
CHEAP_MODEL=anthropic/claude-haiku-5.5
STRONG_MODEL=anthropic/claude-sonnet-5.5
FALLBACK_MODELS=openai/gpt-5-mini,google/gemini-3.5-flash
REASONING_EFFORT=low

# Shared caps (every agent except the monitor)
MAX_LLM_CALLS_PER_RUN=60
MAX_COST_USD_PER_RUN=0.50

# Competitor monitor (its own models and caps)
JUDGE_MODEL=anthropic/claude-haiku-5.5
SUMMARY_MODEL=anthropic/claude-sonnet-5.5
RELEVANCE_THRESHOLD=6
DB_PATH=monitor.db

# Switches
MOCK_LLM=0          # 1 = never call the network (tests and demos)
DRY_RUN=1           # 1 = print the digest instead of posting it
AGENT_ENABLED=1     # 0 = kill switch: every model call is refused
